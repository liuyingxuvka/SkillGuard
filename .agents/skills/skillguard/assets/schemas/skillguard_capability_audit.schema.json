{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillguard.local/schemas/skillguard_capability_audit.schema.json",
  "title": "SkillGuard capability audit report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "artifact_type", "status", "decision", "claim_scope", "findings", "gap_codes", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "skillguard.capability_audit.v1"},
    "artifact_type": {"const": "skillguard_capability_audit"},
    "status": {"enum": ["pass", "blocked"]},
    "decision": {"enum": ["pass", "block"]},
    "claim_scope": {"enum": ["routine", "functional", "release", "highest-quality"]},
    "findings": {"type": "array"},
    "gap_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
