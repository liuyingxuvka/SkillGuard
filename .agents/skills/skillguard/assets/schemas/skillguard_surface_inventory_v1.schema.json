{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuyingxuvka/SkillGuard/schemas/skillguard_surface_inventory_v1.schema.json",
  "title": "SkillGuard target-owned surface inventory v1",
  "description": "An explicit target-owned inventory of externally meaningful surfaces and their intent, owner, route, checks, and evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "target_skill_id",
    "source_kind",
    "source_paths",
    "observed_surface_ids",
    "owner_ids",
    "rows",
    "current_obligation_ids",
    "model_obligations",
    "full_surface_ids",
    "full_surfaces",
    "surface_category_dispositions",
    "full_discovery_fingerprint",
    "adequacy_check_ids",
    "model_deepening_check_id",
    "inventory_hash",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "skillguard.surface_inventory.v1"},
    "inventory_id": {"$ref": "#/$defs/id"},
    "target_skill_id": {"$ref": "#/$defs/id"},
    "source_kind": {"$ref": "#/$defs/text"},
    "source_paths": {"$ref": "#/$defs/paths"},
    "observed_surface_ids": {"$ref": "#/$defs/nonempty_ids"},
    "owner_ids": {"$ref": "#/$defs/nonempty_ids"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/row"}
    },
    "reverse_surface_ids": {"$ref": "#/$defs/nonempty_ids"},
    "reverse_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reverse_row"}
    },
    "full_surface_ids": {"$ref": "#/$defs/nonempty_ids"},
    "current_obligation_ids": {"$ref": "#/$defs/nonempty_ids"},
    "model_obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/model_obligation"}
    },
    "full_surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/full_row"}
    },
    "surface_category_dispositions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/category_disposition"
      }
    },
    "full_discovery_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "adequacy_check_ids": {"$ref": "#/$defs/nonempty_ids"},
    "model_deepening_check_id": {"$ref": "#/$defs/id"},
    "inventory_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claim_boundary": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"},
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nonempty_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "kind",
        "name",
        "disposition",
        "intent_id",
        "owner_id",
        "function_id",
        "required_check_ids",
        "adequacy_check_ids",
        "evidence_subject_ids"
      ],
      "properties": {
        "surface_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["command", "route", "script", "dispatch", "api", "ui", "config", "installer", "provider", "fault", "artifact", "component", "other"]},
        "name": {"$ref": "#/$defs/text"},
        "disposition": {"enum": ["governed", "internal_proven", "retired_proven", "not_applicable_proven"]},
        "intent_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "route_id": {"type": "string", "minLength": 1},
        "function_id": {"$ref": "#/$defs/id"},
        "required_check_ids": {"$ref": "#/$defs/nonempty_ids"},
        "adequacy_check_ids": {"$ref": "#/$defs/nonempty_ids"},
        "evidence_subject_ids": {"$ref": "#/$defs/nonempty_ids"},
        "source_path": {"$ref": "#/$defs/text"},
        "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "symbol": {"$ref": "#/$defs/text"},
        "disposition_reason": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "governed"}}},
          "then": {"required": ["route_id"]}
        },
        {
          "if": {"properties": {"disposition": {"enum": ["internal_proven", "retired_proven", "not_applicable_proven"]}}},
          "then": {"required": ["disposition_reason"]}
        }
      ]
    },
    "reverse_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id",
        "kind",
        "name",
        "disposition",
        "intent_id",
        "owner_id",
        "function_id",
        "required_check_ids",
        "adequacy_check_ids",
        "evidence_subject_ids"
      ],
      "properties": {
        "surface_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["script", "dispatch", "route"]},
        "name": {"$ref": "#/$defs/text"},
        "disposition": {"enum": ["governed", "internal_proven", "retired_proven", "not_applicable_proven"]},
        "intent_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "route_id": {"type": "string", "minLength": 1},
        "function_id": {"$ref": "#/$defs/id"},
        "required_check_ids": {"$ref": "#/$defs/nonempty_ids"},
        "adequacy_check_ids": {"$ref": "#/$defs/nonempty_ids"},
        "evidence_subject_ids": {"$ref": "#/$defs/nonempty_ids"},
        "source_path": {"$ref": "#/$defs/text"},
        "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "symbol": {"$ref": "#/$defs/text"},
        "disposition_reason": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "governed"}}},
          "then": {"required": ["route_id"]}
        },
        {
          "if": {"properties": {"disposition": {"enum": ["internal_proven", "retired_proven", "not_applicable_proven"]}}},
          "then": {"required": ["disposition_reason"]}
        }
      ]
    },
    "full_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface_id", "kind", "name", "source_path", "source_fingerprint", "function_id",
        "route_id", "review_group_id", "review_granularity", "disposition", "intent_id", "owner_id",
        "obligation_ids", "model_obligation_ids", "required_check_ids", "adequacy_check_ids",
        "execution_owner_ids", "evidence_subject_ids"
      ],
      "properties": {
        "surface_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["command", "option", "route", "script", "dispatch", "api", "export", "template", "prompt", "config", "installer", "provider", "effect", "ui", "fault", "recovery", "artifact", "component", "other"]},
        "name": {"$ref": "#/$defs/text"},
        "source_path": {"$ref": "#/$defs/text"},
        "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_symbol_or_route": {"$ref": "#/$defs/text"},
        "component_members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "function_id": {"$ref": "#/$defs/id"},
        "route_id": {"$ref": "#/$defs/text"},
        "review_group_id": {"$ref": "#/$defs/id"},
        "review_granularity": {"enum": ["surface", "component"]},
        "intent_id": {"$ref": "#/$defs/id"},
        "owner_id": {"$ref": "#/$defs/id"},
        "obligation_ids": {"$ref": "#/$defs/nonempty_ids"},
        "model_obligation_ids": {"$ref": "#/$defs/nonempty_ids"},
        "required_check_ids": {"$ref": "#/$defs/nonempty_ids"},
        "adequacy_check_ids": {"$ref": "#/$defs/nonempty_ids"},
        "execution_owner_ids": {"$ref": "#/$defs/nonempty_ids"},
        "evidence_subject_ids": {"$ref": "#/$defs/nonempty_ids"},
        "lifecycle_phase": {"$ref": "#/$defs/text"},
        "consumer_exposure": {"$ref": "#/$defs/text"},
        "write_authority": {"$ref": "#/$defs/text"},
        "disposition": {"enum": ["governed", "internal_proven", "retired_proven", "not_applicable_proven"]},
        "disposition_reason": {"$ref": "#/$defs/text"},
        "disposition_proof_ref": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "governed"}}}, "then": {"required": ["lifecycle_phase", "consumer_exposure", "write_authority"]}},
        {"if": {"properties": {"disposition": {"enum": ["internal_proven", "retired_proven", "not_applicable_proven"]}}}, "then": {"required": ["disposition_reason", "disposition_proof_ref"]}}
      ]
    },
    "model_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "disposition", "surface_ids", "reason", "proof_ref"],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/id"},
        "disposition": {"enum": ["governed", "model_only_proven", "retired_proven", "not_applicable_proven"]},
        "surface_ids": {"$ref": "#/$defs/ids"},
        "reason": {"$ref": "#/$defs/text"},
        "proof_ref": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "governed"}}},
          "then": {"properties": {"surface_ids": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"disposition": {"enum": ["model_only_proven", "retired_proven", "not_applicable_proven"]}}},
          "then": {"properties": {"surface_ids": {"maxItems": 0}}}
        }
      ]
    },
    "category_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "reason", "proof_ref"],
      "properties": {
        "disposition": {"enum": ["governed", "internal_proven", "retired_proven", "not_applicable_proven"]},
        "reason": {"$ref": "#/$defs/text"},
        "proof_ref": {"$ref": "#/$defs/text"}
      }
    }
  }
}
